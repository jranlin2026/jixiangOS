{
  "session": {
    "dmScope": "per-account-channel-peer"
  },
  "agents": {
    "list": [
      {
        "id": "jixiangos-crm",
        "workspace": "<OPENCLAW_AGENT_WORKSPACE>",
        "tools": {
          "allow": [
            "jxos_customer_check",
            "jxos_customer_create"
          ]
        }
      }
    ]
  },
  "bindings": [
    {
      "agentId": "jixiangos-crm",
      "match": {
        "channel": "openclaw-weixin",
        "accountId": "<WEIXIN_ACCOUNT_ID>",
        "peer": {
          "kind": "direct",
          "id": "<ALLOWLISTED_PRIVATE_SENDER_ID>"
        }
      }
    }
  ],
  "channels": {
    "openclaw-weixin": {
      "dmPolicy": "allowlist",
      "allowFrom": [
        "<ALLOWLISTED_PRIVATE_SENDER_ID>"
      ],
      "contextVisibility": "allowlist"
    }
  },
  "mcp": {
    "servers": {
      "jixiangos-crm": {
        "command": "npm.cmd",
        "args": [
          "run",
          "mcp:openclaw:start"
        ],
        "cwd": "<REPOSITORY_ROOT>",
        "env": {
          "JIXIANG_OS_API_BASE": "<JIXIANG_OS_API_BASE>",
          "JIXIANG_OS_AUTOMATION_TOKEN": "<JIXIANG_OS_AUTOMATION_TOKEN>",
          "JIXIANG_OS_WECHAT_SENDER_ID": "<ALLOWLISTED_PRIVATE_SENDER_ID>",
          "JIXIANG_OS_CUSTOMER_DETAIL_URL_TEMPLATE": "<JIXIANG_OS_CUSTOMER_DETAIL_URL_TEMPLATE>",
          "JIXIANG_OS_REQUEST_TIMEOUT_MS": "<JIXIANG_OS_REQUEST_TIMEOUT_MS>"
        },
        "toolFilter": {
          "include": [
            "jxos_customer_check",
            "jxos_customer_create"
          ]
        }
      }
    }
  }
}
