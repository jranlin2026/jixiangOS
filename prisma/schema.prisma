generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Department {
  id          String   @id @db.VarChar(64)
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(64)
  description String?  @db.VarChar(500)
  parentId    String?  @db.VarChar(64)
  managerId   String?  @db.VarChar(64)
  memberCount Int      @default(0)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
  @@index([updatedAt], map: "departments_updatedAt_idx")
  @@map("departments")
}

model Position {
  id              String   @id @db.VarChar(64)
  name            String   @db.VarChar(100)
  code            String   @unique @db.VarChar(64)
  departmentId    String?  @db.VarChar(64)
  departmentScope String   @default("DEPARTMENT_ONLY") @db.VarChar(24)
  description     String?  @db.VarChar(500)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  standards     PositionStandard[]
  taskTemplates TaskTemplate[]

  @@index([departmentId])
  @@map("positions")
}

model Role {
  id             String   @id @db.VarChar(64)
  name           String   @db.VarChar(100)
  normalizedName String   @unique(map: "roles_normalized_name_key") @db.VarChar(191)
  code           String   @unique @db.VarChar(64)
  description    String?  @db.VarChar(500)
  departmentId   String?  @db.VarChar(64)
  permissions    Json
  dataScopes     Json?
  memberCount    Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([departmentId])
  @@index([updatedAt], map: "roles_updatedAt_idx")
  @@map("roles")
}

model User {
  id                 String    @id @db.VarChar(64)
  name               String    @db.VarChar(100)
  account            String?   @unique @db.VarChar(100)
  email              String    @unique @db.VarChar(200)
  phone              String    @db.VarChar(50)
  role               String    @db.VarChar(100)
  avatar             String?   @db.VarChar(500)
  departmentId       String?   @db.VarChar(64)
  positionId         String?   @db.VarChar(64)
  positionName       String?   @db.VarChar(100)
  roleId             String?   @db.VarChar(64)
  passwordHash       String?   @db.VarChar(100)
  passwordSalt       String?   @db.VarChar(100)
  passwordUpdatedAt  DateTime?
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  isActive           Boolean   @default(true)
  employmentStatus   String    @default("active") @db.VarChar(20)
  leftAt             DateTime?
  leftBy             String?   @db.VarChar(100)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions AuthSession[]
  browserAgentGrants BrowserAgentAuthGrant[]
  browserAgentSessions BrowserAgentSession[]

  @@index([departmentId])
  @@index([roleId])
  @@index([updatedAt], map: "users_updatedAt_idx")
  @@map("users")
}

model AuthSession {
  id        String    @id @db.VarChar(64)
  token     String    @unique @db.VarChar(120)
  userId    String    @db.VarChar(64)
  remember  Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model BrowserAgentAuthGrant {
  jti             String    @id @db.VarChar(64)
  userId          String    @db.VarChar(64)
  parentSessionId String    @db.VarChar(64)
  deviceId        String    @db.VarChar(128)
  redirectUri     String    @db.VarChar(255)
  codeChallenge   String    @db.VarChar(100)
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([parentSessionId])
  @@map("browser_agent_auth_grants")
}

model BrowserAgentSession {
  jti             String    @id @db.VarChar(64)
  userId          String    @db.VarChar(64)
  parentSessionId String    @db.VarChar(64)
  deviceId        String    @db.VarChar(128)
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([parentSessionId])
  @@map("browser_agent_sessions")
}

model PositionMappingBatch {
  id              String    @id @db.VarChar(64)
  status          String    @default("PREVIEW") @db.VarChar(24)
  scope           Json?
  totalCount      Int       @default(0)
  matchedCount    Int       @default(0)
  conflictCount   Int       @default(0)
  appliedCount    Int       @default(0)
  failedCount     Int       @default(0)
  createdById     String    @db.VarChar(64)
  createdByName   String    @db.VarChar(100)
  confirmedById   String?   @db.VarChar(64)
  confirmedByName String?   @db.VarChar(100)
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items PositionMappingItem[]

  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@map("position_mapping_batches")
}

model PositionMappingItem {
  id                        String    @id @db.VarChar(64)
  batchId                   String    @db.VarChar(64)
  employeeId                String    @db.VarChar(64)
  employeeName              String    @db.VarChar(100)
  originalDepartmentId      String?   @db.VarChar(64)
  originalDepartmentName    String?   @db.VarChar(100)
  originalPositionName      String?   @db.VarChar(100)
  employeeUpdatedAtSnapshot DateTime
  suggestedPositionId       String?   @db.VarChar(64)
  candidatePositionIds      Json
  confirmedPositionId       String?   @db.VarChar(64)
  matchStatus               String    @db.VarChar(32)
  applyStatus               String    @default("PENDING") @db.VarChar(24)
  failureReason             String?   @db.VarChar(500)
  appliedAt                 DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  batch PositionMappingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, employeeId])
  @@index([employeeId, createdAt])
  @@index([matchStatus, applyStatus])
  @@map("position_mapping_items")
}

model EmployeePositionHistory {
  id                String   @id @db.VarChar(64)
  employeeId        String   @db.VarChar(64)
  employeeName      String   @db.VarChar(100)
  changeType        String   @db.VarChar(32)
  oldDepartmentId   String?  @db.VarChar(64)
  oldDepartmentName String?  @db.VarChar(100)
  newDepartmentId   String?  @db.VarChar(64)
  newDepartmentName String?  @db.VarChar(100)
  oldPositionId     String?  @db.VarChar(64)
  oldPositionName   String?  @db.VarChar(100)
  newPositionId     String?  @db.VarChar(64)
  newPositionName   String?  @db.VarChar(100)
  reason            String?  @db.VarChar(500)
  source            String   @db.VarChar(24)
  changedById       String   @db.VarChar(64)
  changedByName     String   @db.VarChar(100)
  changedAt         DateTime @default(now())
  idempotencyKey    String   @unique @db.VarChar(191)

  @@index([employeeId, changedAt])
  @@index([changeType, changedAt])
  @@index([changedById, changedAt])
  @@map("employee_position_histories")
}

model AppStorage {
  key       String   @id @db.VarChar(120)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt], map: "app_storage_updatedAt_idx")
  @@map("app_storage")
}

model AiProviderConfig {
  id        String   @id @default("default") @db.VarChar(32)
  provider  String   @default("deepseek") @db.VarChar(40)
  apiKey    String   @db.Text
  baseUrl   String   @default("https://api.deepseek.com") @db.VarChar(255)
  model     String   @default("deepseek-chat") @db.VarChar(100)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_provider_configs")
}

model BrowserShopBinding {
  id              String                  @id @db.VarChar(64)
  businessPlatformId String?               @db.VarChar(64)
  businessShopId   String?                 @unique @db.VarChar(64)
  platform        String                  @db.VarChar(40)
  shopKey         String                  @db.VarChar(120)
  platformShopId  String?                 @db.VarChar(160)
  displayName     String                  @db.VarChar(160)
  aliases         Json
  source          String                  @default("抖音电商") @db.VarChar(80)
  sourceName      String                  @default("飞鸽客服") @db.VarChar(80)
  sourceType      String                  @default("公司资源") @db.VarChar(40)
  active          Boolean                 @default(true)
  createdById     String                  @db.VarChar(64)
  createdByName   String                  @db.VarChar(100)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  productMappings BrowserProductMapping[]

  @@unique([platform, shopKey])
  @@index([platform, platformShopId])
  @@index([active, updatedAt])
  @@map("browser_shop_bindings")
}

model BrowserProductMapping {
  id                  String             @id @db.VarChar(64)
  shopBindingId       String             @db.VarChar(64)
  platformIdentityKey String             @db.VarChar(300)
  platformProductId   String?            @db.VarChar(200)
  platformSkuId       String?            @db.VarChar(200)
  platformProductName String             @db.VarChar(500)
  aliases             Json
  osProductId         String             @db.VarChar(64)
  osProductName       String             @db.VarChar(200)
  active              Boolean            @default(true)
  confirmedById       String             @db.VarChar(64)
  confirmedByName     String             @db.VarChar(100)
  confirmedAt         DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  shopBinding         BrowserShopBinding @relation(fields: [shopBindingId], references: [id], onDelete: Restrict)

  @@unique([shopBindingId, platformIdentityKey])
  @@index([shopBindingId, active, updatedAt])
  @@index([osProductId])
  @@map("browser_product_mappings")
}

model BrowserLeadSync {
  id                  String    @id @db.VarChar(64)
  platform            String    @db.VarChar(40)
  shopKey             String    @db.VarChar(120)
  platformOrderNo     String    @db.VarChar(160)
  shopBindingId       String?   @db.VarChar(64)
  shopDisplayName     String?   @db.VarChar(160)
  platformProductId   String?   @db.VarChar(200)
  platformSkuId       String?   @db.VarChar(200)
  sourceProductName   String?   @db.VarChar(240)
  matchedProductId    String?   @db.VarChar(64)
  matchedProductName  String?   @db.VarChar(200)
  productMatchMethod  String?   @db.VarChar(40)
  sourcePaymentAmount Decimal?  @db.Decimal(14, 2)
  sourcePaymentAt     DateTime?
  operatorId          String    @db.VarChar(64)
  operatorName        String    @db.VarChar(100)
  contactSource       String    @db.VarChar(24)
  status              String    @default("PENDING") @db.VarChar(24)
  leadId              String?   @db.VarChar(64)
  leadName            String?   @db.VarChar(200)
  contactNickname     String?   @db.VarChar(200)
  contactPhone        String?   @db.VarChar(40)
  contactWechat       String?   @db.VarChar(120)
  assignedTo          String?   @db.VarChar(100)
  assignedToId        String?   @db.VarChar(64)
  intakeStatus        String?   @db.VarChar(40)
  orderRemarkStatus   String    @default("NOT_ATTEMPTED") @db.VarChar(24)
  orderRemarkError    String?   @db.VarChar(1000)
  greenFlagStatus     String    @default("NOT_ATTEMPTED") @db.VarChar(24)
  greenFlagError      String?   @db.VarChar(1000)
  remarkOperatorId    String?   @db.VarChar(64)
  remarkOperatorName  String?   @db.VarChar(100)
  attemptCount        Int       @default(1)
  attemptToken        String?   @db.VarChar(64)
  lastError           String?   @db.VarChar(1000)
  completedAt         DateTime?
  orderRemarkedAt     DateTime?
  greenFlaggedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([platform, shopKey, platformOrderNo])
  @@index([operatorId, createdAt])
  @@index([status, updatedAt])
  @@index([leadId])
  @@index([shopBindingId])
  @@index([matchedProductId])
  @@map("browser_lead_syncs")
}

enum SystemInstallationState {
  UNINITIALIZED
  INITIALIZING
  ACTIVE
  RESETTING
  FAILED
}

model SystemInstallation {
  id             String                  @id @default("primary") @db.VarChar(32)
  installationId String                  @unique @db.VarChar(64)
  state          SystemInstallationState @default(UNINITIALIZED)
  setupVersion   Int                     @default(1)
  companyName    String?                 @db.VarChar(100)
  initializedAt  DateTime?
  lastError      String?                 @db.VarChar(100)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@map("system_installations")
}

enum CoCreationStatus {
  DRAFT
  INTERVIEWING
  EMPLOYEE_CONFIRMATION
  FACT_CONFIRMATION
  MANAGEMENT_REVIEW
  VALIDATION_APPROVED
  VALIDATING
  PROJECT_DECISION
  APPROVED
  DEFERRED
  MERGED
  REJECTED
}

enum CoCreationMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model CoCreationRequest {
  id             String           @id @db.VarChar(64)
  title          String           @db.VarChar(200)
  status         CoCreationStatus @default(DRAFT)
  requesterId    String           @db.VarChar(64)
  requesterName  String           @db.VarChar(100)
  departmentId   String?          @db.VarChar(64)
  supervisorId   String?          @db.VarChar(64)
  mergedIntoId   String?          @db.VarChar(64)
  decisionReason String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  messages   CoCreationMessage[]
  brief      CoCreationBrief?
  validation CoCreationValidation?
  events     CoCreationEvent[]

  @@index([requesterId, createdAt])
  @@index([departmentId, status])
  @@index([supervisorId, status])
  @@index([status, updatedAt])
  @@map("co_creation_requests")
}

model CoCreationMessage {
  id        String                @id @db.VarChar(64)
  requestId String                @db.VarChar(64)
  role      CoCreationMessageRole
  content   String                @db.Text
  metadata  Json?
  createdAt DateTime              @default(now())

  request CoCreationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("co_creation_messages")
}

model CoCreationBrief {
  id                  String    @id @db.VarChar(64)
  requestId           String    @unique @db.VarChar(64)
  problemStatement    String    @db.Text
  currentWorkflow     String    @db.Text
  painPoints          Json
  affectedRoles       Json
  frequency           String?   @db.VarChar(100)
  impact              String?   @db.Text
  desiredOutcome      String    @db.Text
  acceptanceCriteria  Json
  evidence            Json
  employeeStatements  Json
  aiHypotheses        Json
  confirmedFacts      Json
  openQuestions       Json
  classification      String?   @db.VarChar(100)
  prioritySuggestion  String?   @db.VarChar(20)
  completeness        Int       @default(0)
  employeeConfirmedAt DateTime?
  factsConfirmedAt    DateTime?
  factsConfirmedBy    String?   @db.VarChar(64)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  request CoCreationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("co_creation_briefs")
}

model CoCreationValidation {
  id                  String    @id @db.VarChar(64)
  requestId           String    @unique @db.VarChar(64)
  ownerId             String?   @db.VarChar(64)
  plan                Json
  evidence            Json
  confirmedFacts      Json
  metrics             Json
  unresolvedQuestions Json
  recommendation      String?   @db.Text
  conclusion          String?   @db.Text
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  request CoCreationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("co_creation_validations")
}

model CoCreationEvent {
  id        String   @id @db.VarChar(64)
  requestId String   @db.VarChar(64)
  actorId   String   @db.VarChar(64)
  actorName String   @db.VarChar(100)
  action    String   @db.VarChar(100)
  fromState String?  @db.VarChar(50)
  toState   String?  @db.VarChar(50)
  detail    Json?
  createdAt DateTime @default(now())

  request CoCreationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
  @@map("co_creation_events")
}

model LeadRecord {
  id                  String   @id @db.VarChar(64)
  externalIntakeKey   String?  @unique @db.VarChar(191)
  name                String   @db.VarChar(120)
  company             String?  @db.VarChar(200)
  phone               String?  @db.VarChar(50)
  wechat              String?  @db.VarChar(100)
  source              String?  @db.VarChar(120)
  status              String?  @db.VarChar(50)
  lifecycleStatusCode String?  @db.VarChar(80)
  owner               String?  @db.VarChar(100)
  assignedTo          String?  @db.VarChar(100)
  inputBy             String?  @db.VarChar(100)
  leadContributorId   String?  @db.VarChar(64)
  data                Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([phone])
  @@index([owner])
  @@index([assignedTo])
  @@index([status])
  @@index([createdAt])
  @@map("lead_records")
}

model BusinessRecord {
  id             String    @id @db.VarChar(160)
  domain         String    @db.VarChar(80)
  recordId       String    @db.VarChar(80)
  title          String?   @db.VarChar(240)
  status         String?   @db.VarChar(80)
  owner          String?   @db.VarChar(120)
  customerId     String?   @db.VarChar(80)
  orderId        String?   @db.VarChar(80)
  amount         Decimal?  @db.Decimal(14, 2)
  eventAt        DateTime?
  mergedIntoId   String?   @db.VarChar(80)
  mergedAt       DateTime?
  mergedById     String?   @db.VarChar(64)
  mergedByName   String?   @db.VarChar(100)
  mergeLedgerId  String?   @db.VarChar(64)
  recordRevision Int       @default(0)
  data           Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([domain, recordId])
  @@index([domain])
  @@index([domain, status])
  @@index([domain, eventAt, createdAt])
  @@index([domain, createdAt, id], map: "business_records_domain_createdAt_id_idx")
  @@index([status])
  @@index([owner])
  @@index([customerId])
  @@index([orderId])
  @@index([eventAt])
  @@index([domain, mergedIntoId])
  @@index([domain, mergeLedgerId])
  @@index([domain, updatedAt], map: "business_records_domain_updatedAt_idx")
  @@map("business_records")
}

model BusinessExportAudit {
  id              String   @id @default(cuid()) @db.VarChar(64)
  module          String   @db.VarChar(40)
  actorId         String   @db.VarChar(64)
  actorName       String   @db.VarChar(100)
  reason          String   @db.Text
  filtersSnapshot Json
  columnMode      String   @db.VarChar(20)
  columns         Json
  summaryRowCount Int
  detailRowCount  Int
  filename        String   @db.VarChar(255)
  createdAt       DateTime @default(now())

  @@index([module, createdAt])
  @@index([actorId, createdAt])
  @@map("business_export_audits")
}

enum CustomerTodoStatus {
  PENDING
  COMPLETED
  CANCELED
}

model CustomerTodo {
  id              String             @id @db.VarChar(64)
  customerId      String             @db.VarChar(80)
  customerName    String             @db.VarChar(200)
  title           String             @db.VarChar(120)
  content         String?            @db.Text
  status          CustomerTodoStatus @default(PENDING)
  dueAt           DateTime
  executionMethod String             @default("none") @db.VarChar(20)
  assigneeId      String             @db.VarChar(64)
  assigneeName    String             @db.VarChar(100)
  createdById     String             @db.VarChar(64)
  createdByName   String             @db.VarChar(100)
  completedAt     DateTime?
  completedById   String?            @db.VarChar(64)
  completedByName String?            @db.VarChar(100)
  canceledAt      DateTime?
  canceledById    String?            @db.VarChar(64)
  canceledByName  String?            @db.VarChar(100)
  cancelReason    String?            @db.VarChar(500)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([customerId, status, dueAt])
  @@index([assigneeId, status, dueAt])
  @@map("customer_todos")
}

enum NotificationSeverity {
  S0
  S1
  S2
  S3
}

enum NotificationChannel {
  FEISHU
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum ReminderScheduleStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELED
  FAILED
}

model Notification {
  id             String               @id @db.VarChar(64)
  eventType      String               @db.VarChar(80)
  businessType   String               @db.VarChar(40)
  businessId     String               @db.VarChar(80)
  recipientId    String               @db.VarChar(64)
  recipientName  String               @db.VarChar(100)
  title          String               @db.VarChar(200)
  content        String?              @db.Text
  severity       NotificationSeverity @default(S2)
  actionUrl      String               @db.VarChar(500)
  requiresAck    Boolean              @default(false)
  dedupeKey      String               @unique @db.VarChar(191)
  metadata       Json?
  readAt         DateTime?
  ackAt          DateTime?
  resolvedAt     DateTime?
  resolvedReason String?              @db.VarChar(500)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  deliveries NotificationDelivery[]

  @@index([recipientId, resolvedAt, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@index([businessType, businessId, resolvedAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @db.VarChar(64)
  notificationId String                     @db.VarChar(64)
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attemptCount   Int                        @default(0)
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  lastError      String?                    @db.VarChar(500)
  leaseOwner     String?                    @db.VarChar(100)
  leaseExpiresAt DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@index([leaseOwner, leaseExpiresAt])
  @@map("notification_deliveries")
}

model ReminderSchedule {
  id              String                 @id @db.VarChar(64)
  eventType       String                 @db.VarChar(80)
  businessType    String                 @db.VarChar(40)
  businessId      String                 @db.VarChar(80)
  recipientId     String                 @db.VarChar(64)
  recipientName   String                 @db.VarChar(100)
  title           String                 @db.VarChar(200)
  content         String?                @db.Text
  severity        NotificationSeverity   @default(S2)
  actionUrl       String                 @db.VarChar(500)
  requiresAck     Boolean                @default(false)
  dedupeKey       String                 @unique @db.VarChar(191)
  channels        Json
  metadata        Json?
  scheduledAt     DateTime
  escalationLevel Int                    @default(0)
  status          ReminderScheduleStatus @default(PENDING)
  leaseOwner      String?                @db.VarChar(100)
  leaseExpiresAt  DateTime?
  attemptCount    Int                    @default(0)
  completedAt     DateTime?
  canceledAt      DateTime?
  cancelReason    String?                @db.VarChar(500)
  lastError       String?                @db.VarChar(500)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, scheduledAt])
