# Local-only template for a sanitized production clone.
# Copy outside the repository or to an ignored .env.local file. Never paste production values here.

NODE_ENV=development

# Must be a loopback host, a dedicated account, and a dedicated empty clone database.
DATABASE_URL="mysql://jixiang_os_clone:REPLACE_WITH_LOCAL_ONLY_PASSWORD@127.0.0.1:3306/jixiang_os_prod_clone_test"
JIXIANG_MYSQL_HOST=127.0.0.1
JIXIANG_MYSQL_PORT=3306
JIXIANG_MYSQL_DATABASE=jixiang_os_prod_clone_test
JIXIANG_MYSQL_USER=jixiang_os_clone
JIXIANG_MYSQL_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD

AI_PROXY_HOST=127.0.0.1
AI_PROXY_PORT=3001
CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"
VITE_USE_BACKEND_API=true
VITE_AI_API_BASE="/api"

# Repository-external or gitignored local test directories only.
ENABLEMENT_PRIVATE_STORAGE_DIR=private_uploads/clone-test/enablement
BUSINESS_ATTACHMENT_STORAGE_DIR=uploads-private/clone-test/business-attachments

# Disable AI and do not configure SMS, email, payment, webhook, or cloud-storage credentials.
DEEPSEEK_API_KEY=""

# Generate fresh local-only values. Never reuse production secrets.
JIXIANG_DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
JIXIANG_DEFAULT_USER_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
CUSTOMER_PERMISSION_MIGRATION_SIGNING_KEY=REPLACE_WITH_LOCAL_ONLY_RANDOM_VALUE
CUSTOMER_DATA_EXCHANGE_SIGNING_KEY=REPLACE_WITH_LOCAL_ONLY_RANDOM_VALUE
BUSINESS_IMPORT_SIGNING_KEY=REPLACE_WITH_LOCAL_ONLY_RANDOM_VALUE
CONTACT_IDENTITY_HMAC_KEY=REPLACE_WITH_LOCAL_ONLY_BASE64_KEY
CONTACT_IDENTITY_HMAC_KEY_VERSION=local-1
CONTACT_IDENTITY_ENCRYPTION_KEY=REPLACE_WITH_LOCAL_ONLY_BASE64_KEY
CONTACT_IDENTITY_ENCRYPTION_KEY_VERSION=local-1
CUSTOMER_MERGE_SNAPSHOT_ACTIVE_KEY_VERSION=local-1
CUSTOMER_MERGE_SNAPSHOT_KEYS_JSON={"local-1":"REPLACE_WITH_LOCAL_ONLY_BASE64_KEY"}

JIXIANG_SESSION_TTL_HOURS=8
JIXIANG_REMEMBER_SESSION_DAYS=1
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_BLOCK_MS=900000

# Keep clone backups outside the repository. This path is intentionally invalid until approved.
JIXIANG_BACKUP_DIR=/REPLACE_WITH_REPOSITORY_EXTERNAL_PATH/jixiang-clone-backups
JIXIANG_BACKUP_KEEP_DAYS=7
# First migration rehearsal should keep every backup in a dedicated empty directory.
JIXIANG_BACKUP_PRUNE=NO
# Set to YES only after the approved source system write pause is in effect.
JIXIANG_BACKUP_WRITES_PAUSED=NO

# Production-only values must remain unset locally.
JIXIANG_SETUP_TOKEN=
JIXIANG_PRISMA_BASELINE_CONFIRMED=
JIXIANG_SMOKE_PASSWORD=
